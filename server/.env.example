# Copy this file to `server/.env` for local development (it is gitignored).
# On a host like Vercel or Render, set these in the project's dashboard instead.

# Port the API listens on. The Vite dev proxy in client/vite.config.js expects 4000.
# Serverless hosts assign this themselves — leave it unset there.
PORT=4000

# Comma-separated origins allowed to call the API from a browser.
# Leave EMPTY to allow any origin (fine for this public, unauthenticated endpoint).
# Set it once the frontend has a fixed URL, e.g.
#   ALLOWED_ORIGINS=https://client-xxxx-sidsigma3s-projects.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=
