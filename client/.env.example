# Origin of the backend API. Copy to `.env.local` to override locally.
#
# Leave EMPTY for local development — `npm run dev` proxies /api to
# http://localhost:4000 (see vite.config.js), so requests stay same-origin.
#
# Set it when the frontend and backend are deployed separately, e.g.
#   VITE_API_BASE_URL=https://server-xxxxxxxx-sidsigma3s-projects.vercel.app
#
# A bare host works too — the scheme is added for you.
VITE_API_BASE_URL=
